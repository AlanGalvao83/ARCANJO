# ============================================================================
# ARCANJO INTELLIGENCE — Variáveis de Ambiente (.env / Vercel)
# ============================================================================

# Opção 1: Integração via API do Supabase (Copiadas da aba "Connect to your project")
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://seu-projeto.supabase.co/auth/v1/.well-known/jwks.json

# Opção 2 (Opcional): Conexão direta PostgreSQL URI
# DATABASE_URL=postgresql://postgres:[SUA_SENHA]@db.[SEU_PROJETO].supabase.co:5432/postgres
