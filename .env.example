# Conexão com o Banco de Dados Supabase (PostgreSQL)
# Obtenha em: Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
# Se deixar vazio localmente, o sistema utilizará automaticamente o SQLite (arcanjo.db).
DATABASE_URL=postgresql://postgres:[SUA_SENHA]@db.[SEU_PROJETO].supabase.co:5432/postgres
